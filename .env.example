# ===================
# Required Secrets
# ===================

# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-api-key-here

# ===================
# Configuration
# ===================

# Default image resolution: 1K, 2K, or 4K (uppercase K only)
# IMAGE_RESOLUTION=2K

# Default aspect ratio
# IMAGE_ASPECT_RATIO=16:9
